FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -o /out/fugue-ssh-front ./cmd/fugue-ssh-front

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/fugue-ssh-front /usr/local/bin/fugue-ssh-front
ENTRYPOINT ["/usr/local/bin/fugue-ssh-front"]
