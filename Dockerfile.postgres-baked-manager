# The operator image contains both original architecture-specific managers.
# Do not rebuild these executables from source or substitute the patched controller.
FROM --platform=$BUILDPLATFORM ghcr.io/cloudnative-pg/cloudnative-pg@sha256:68074486205a33ed41928761e22ad48278c690feebe8316727a1c6b3380f9e5e AS manager

FROM ghcr.io/cloudnative-pg/postgresql:18.3-system-trixie@sha256:0f29b435fb501ee534cd0c555d122a6b8e90de477de8e8381c82c5e10d9a9de4
ARG TARGETARCH
COPY --from=manager --chmod=0755 /operator/manager_${TARGETARCH} /usr/local/libexec/cnpg-manager
COPY --chmod=0755 scripts/postgres_baked_manager.sh /usr/local/bin/fugue-cnpg-manager
