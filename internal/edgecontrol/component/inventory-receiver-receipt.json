{
  "schema": "edge-control-inventory-receiver-candidate/v1",
  "base_commit": "b9b75596bb84ba701c843b1bafa961cadc74d223",
  "production_mutation_allowed": true,
  "authority_cutover_allowed_without_worker_candidate": false,
  "artifact": {
    "role": "fugue-artifact://edge-control",
    "repository": "ghcr.io/yym68686/fugue-edge-control",
    "dockerfile": "Dockerfile.edge-control",
    "build_package": "./cmd/fugue-edge-control"
  },
  "group_registry": "deploy/releases/edge-groups.json",
  "inventory_contract": {
    "path": "/v1/authority/group-inventory-heartbeats",
    "method": "POST",
    "authentication": "platform component Bearer identity",
    "query_credentials_allowed": false,
    "component": "edge-worker",
    "artifact_kind": "edge_route_bundle",
    "scope": "exact edge group",
    "node": "exact signed node id",
    "cursor": "group-local inventory CAS plus monotonic producer generation",
    "legacy_worker_absence_allowed": true
  },
  "fault_domain": {
    "state": "one durable file and PVC per edge group",
    "signature": "one signing keyring per edge group",
    "publication": "one CAS ledger per edge group",
    "cross_group_transaction": false,
    "stale_group_behavior": "preserve only that group last-known-good publication"
  },
  "rollout": {
    "artifact_batches": 1,
    "group_source": "edge_group_registry",
    "groups_are_sequential": true
  },
  "rollback": {
    "artifact": "restore previous edge-control artifact",
    "state": "preserve group PVC and last-known-good publication",
    "automatic_cross_group_action": false
  }
}
