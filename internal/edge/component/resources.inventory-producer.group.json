                "args": [
                  "umask 022; test -n \"${FUGUE_EDGE_IDENTITY_NODE_NAME}\"; printf '%s\\n' \"${FUGUE_EDGE_IDENTITY_NODE_NAME}\" \u003e/var/run/fugue/edge-identity/edge_id; for field in edge_group_id slot instance_uid release_epoch heartbeat_fenced; do test -s \"/var/run/fugue/edge-identity-source/${field}\"; cat \"/var/run/fugue/edge-identity-source/${field}\" \u003e\"/var/run/fugue/edge-identity/${field}\"; done; chmod 0444 /var/run/fugue/edge-identity/*"
                ],
                "command": [
                  "/bin/sh",
                  "-ec"
                ],
                "env": [
                  {
                    "name": "FUGUE_EDGE_IDENTITY_NODE_NAME",
