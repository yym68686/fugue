                "image": "fugue-artifact://edge-worker",
                "imagePullPolicy": "IfNotPresent",
                "name": "edge-workload-identity",
                "resources": {
                  "limits": {
                    "ephemeral-storage": "8Mi",
                    "memory": "32Mi"
                  },
                  "requests": {
                    "cpu": "1m",
                    "ephemeral-storage": "1Mi",
                    "memory": "8Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
