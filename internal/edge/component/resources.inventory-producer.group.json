{
  "apiVersion": "release.fugue.dev/v2",
  "kind": "ComponentResourceSet",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "annotations": {
          "fugue.pro/edge-worker-manifest-state": "materialization-ready",
          "fugue.pro/edge-worker-resource-set": "edge-worker-static-resources/v1"
        },
        "labels": {
        "app.kubernetes.io/component": "@@FRONT_COMPONENT@@",
          "app.kubernetes.io/instance": "fugue",
          "app.kubernetes.io/name": "fugue",
          "fugue.io/edge-group-id": "@@GROUP_ID@@"
        },
        "name": "@@FRONT_NAME@@",
        "namespace": "fugue-system"
      },
      "spec": {
        "revisionHistoryLimit": 2,
        "selector": {
          "matchLabels": {
          "app.kubernetes.io/component": "@@FRONT_COMPONENT@@",
            "app.kubernetes.io/instance": "fugue",
            "app.kubernetes.io/name": "fugue"
          }
        },
        "template": {
          "metadata": {
            "annotations": {
              "fugue.pro/edge-worker-manifest-state": "materialization-ready",
              "fugue.pro/edge-worker-resource-set": "edge-worker-static-resources/v1"
            },
            "labels": {
            "app.kubernetes.io/component": "@@FRONT_COMPONENT@@",
              "app.kubernetes.io/instance": "fugue",
              "app.kubernetes.io/name": "fugue",
              "fugue.io/edge-group-id": "@@GROUP_ID@@"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "command": [
                  "/usr/local/bin/fugue-edge-front"
                ],
                "env": [
                  {
                    "name": "FUGUE_EDGE_FRONT_NODE_HOST",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "status.hostIP"
                      }
                    }
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_EDGE_ID",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_EDGE_GROUP_ID",
                    "value": "@@GROUP_ID@@"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_HTTP_LISTEN_ADDR",
                    "value": ":80"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_HTTPS_LISTEN_ADDR",
                    "value": ":443"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_HEALTH_LISTEN_ADDR",
                    "value": ":7831"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_HTTP_MODE",
                    "value": "redirect"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_ACTIVE_SLOT_FILE",
                    "value": "/var/lib/fugue-edge-front/activation.json"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_REQUIRE_ACTIVATION_STATE",
                    "value": "true"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_DEFAULT_SLOT",
                    "value": "a"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_SLOT_A_HTTP_PORT",
                    "value": "18080"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_SLOT_A_HTTPS_PORT",
                    "value": "18443"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_SLOT_B_HTTP_PORT",
                    "value": "28080"
                  },
                  {
                    "name": "FUGUE_EDGE_FRONT_SLOT_B_HTTPS_PORT",
                    "value": "28443"
                  }
                ],
                "image": "fugue-artifact://edge-worker",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 6,
                  "httpGet": {
                    "path": "/healthz",
                    "port": "health"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "name": "edge-front",
                "ports": [
                  {
                    "containerPort": 80,
                    "hostPort": 80,
                    "name": "http-public",
                    "protocol": "TCP"
                  },
                  {
                    "containerPort": 443,
                    "hostPort": 443,
                    "name": "https-public",
                    "protocol": "TCP"
                  },
                  {
                    "containerPort": 7831,
                    "name": "health",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/readyz",
                    "port": "health"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "ephemeral-storage": "128Mi",
                    "memory": "128Mi"
                  },
                  "requests": {
                    "cpu": "10m",
                    "ephemeral-storage": "16Mi",
                    "memory": "32Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "startupProbe": {
                  "failureThreshold": 600,
                  "httpGet": {
                    "path": "/healthz",
                    "port": "health"
                  },
                  "periodSeconds": 2
                },
                "volumeMounts": [
                  {
                    "mountPath": "/var/lib/fugue-edge-front",
                    "name": "activation-state"
                  }
                ]
              }
            ],
            "enableServiceLinks": false,
            "nodeSelector": {
              "fugue.io/location-country-code": "@@GROUP@@",
              "fugue.io/role.edge": "true",
              "fugue.io/schedulable": "true"
            },
            "serviceAccountName": "@@SERVICE_ACCOUNT@@",
            "terminationGracePeriodSeconds": 30,
            "tolerations": [
              {
                "effect": "NoSchedule",
                "key": "fugue.io/dedicated",
                "operator": "Equal",
                "value": "edge"
              },
              {
                "effect": "NoSchedule",
                "key": "fugue.io/tenant",
                "operator": "Exists"
              }
            ],
            "volumes": [
              {
                "hostPath": {
                  "path": "/var/lib/fugue/edge-owned/@@GROUP_ID@@/front",
                  "type": "DirectoryOrCreate"
                },
                "name": "activation-state"
              }
            ]
          }
        },
        "updateStrategy": {
          "type": "OnDelete"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "annotations": {
          "fugue.pro/edge-worker-manifest-state": "materialization-ready",
          "fugue.pro/edge-worker-resource-set": "edge-worker-static-resources/v1"
        },
        "labels": {
        "app.kubernetes.io/component": "@@WORKER_A_COMPONENT@@",
          "app.kubernetes.io/instance": "fugue",
          "app.kubernetes.io/name": "fugue",
          "fugue.io/edge-group-id": "@@GROUP_ID@@",
          "fugue.io/edge-slot": "a"
        },
        "name": "@@WORKER_A_NAME@@",
        "namespace": "fugue-system"
      },
      "spec": {
        "revisionHistoryLimit": 2,
        "selector": {
          "matchLabels": {
          "app.kubernetes.io/component": "@@WORKER_A_COMPONENT@@",
            "app.kubernetes.io/instance": "fugue",
            "app.kubernetes.io/name": "fugue"
          }
        },
        "template": {
          "metadata": {
            "annotations": {
              "fugue.io/edge-heartbeat-fenced": "true",
              "fugue.pro/edge-worker-manifest-state": "materialization-ready",
              "fugue.pro/edge-worker-resource-set": "edge-worker-static-resources/v1"
            },
            "labels": {
            "app.kubernetes.io/component": "@@WORKER_A_COMPONENT@@",
              "app.kubernetes.io/instance": "fugue",
              "app.kubernetes.io/name": "fugue",
              "fugue.io/edge-control-client": "true",
              "fugue.io/edge-control-inventory-writer": "true",
              "fugue.io/edge-group-id": "@@GROUP_ID@@",
              "fugue.io/edge-slot": "a"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "env": [
                  {
                    "name": "FUGUE_API_URL",
                    "value": "http://fugue-fugue.fugue-system.svc:80"
                  },
                  {
                    "name": "FUGUE_EDGE_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "FUGUE_EDGE_TOKEN",
                        "name": "@@API_SECRET@@"
                      }
                    }
                  },
                  {
                    "name": "FUGUE_EDGE_ROUTE_BUNDLE_URL",
                    "value": "http://@@CONTROL_NAME@@.fugue-system.svc:8092/v1/edge/routes"
                  },
                  {
                    "name": "FUGUE_EDGE_ROUTE_BUNDLE_TOKEN_FILE",
                    "value": "/var/run/secrets/fugue-edge/route-reader/token"
                  },
                  {
                    "name": "FUGUE_EDGE_ROUTE_BUNDLE_VERIFIER_KEYRING_FILE",
                    "value": "/var/run/secrets/fugue-edge/bundle-verifier/keyring.json"
                  },
                  {
                    "name": "FUGUE_EDGE_INVENTORY_AUTHORITY_SERVICE",
                    "value": "@@CONTROL_NAME@@"
                  },
                  {
                    "name": "FUGUE_EDGE_INVENTORY_HEARTBEAT_URL",
                    "value": "http://@@CONTROL_NAME@@.fugue-system.svc:8092/v1/authority/group-inventory-heartbeats"
                  },
                  {
                    "name": "FUGUE_EDGE_INVENTORY_IDENTITY_KEYRING_FILE",
                    "value": "/var/run/secrets/fugue-edge/inventory-identity/keyring.json"
                  },
                  {
                    "name": "FUGUE_EDGE_INVENTORY_ACTIVATION_STATE_FILE",
                    "value": "/var/lib/fugue-edge-front/activation.json"
                  },
                  {
                    "name": "FUGUE_EDGE_INVENTORY_HEARTBEAT_INTERVAL",
                    "value": "30s"
                  },
                  {
                    "name": "FUGUE_EDGE_LISTEN_ADDR",
                    "value": "0.0.0.0:7832"
                  },
                  {
                    "name": "FUGUE_EDGE_ROUTES_CACHE_PATH",
                    "value": "/var/lib/fugue/edge/routes-cache.json"
                  },
                  {
                    "name": "FUGUE_EDGE_AUTONOMY_WAL_PATH",
                    "value": "/var/lib/fugue/edge/autonomy.wal"
                  },
                  {
                    "name": "FUGUE_EDGE_MAX_STALE",
                    "value": "24h"
                  },
                  {
                    "name": "FUGUE_EDGE_SYNC_INTERVAL",
                    "value": "15s"
                  },
                  {
                    "name": "FUGUE_EDGE_HEARTBEAT_INTERVAL",
                    "value": "30s"
                  },
                  {
                    "name": "FUGUE_EDGE_HTTP_TIMEOUT",
                    "value": "10s"
                  },
                  {
                    "name": "FUGUE_EDGE_CADDY_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "FUGUE_EDGE_CADDY_ADMIN_URL",
                    "value": "http://127.0.0.1:2019"
                  },
                  {
                    "name": "FUGUE_EDGE_CADDY_LISTEN_ADDR",
                    "value": ":18443"
                  },
                  {
                    "name": "FUGUE_EDGE_CADDY_TLS_MODE",
                    "value": "public-on-demand"
                  },
                  {
                    "name": "FUGUE_EDGE_CADDY_TLS_ASK_URL",
                    "value": "http://127.0.0.1:7832/edge/tls/ask"
                  },
                  {
                    "name": "FUGUE_EDGE_PROXY_LISTEN_ADDR",
                    "value": "127.0.0.1:7833"
                  }
                ],
                "image": "fugue-artifact://edge-worker",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 12,
                  "httpGet": {
                    "path": "/healthz",
                    "port": "health"
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "name": "edge",
                "ports": [
                  {
                    "containerPort": 7832,
                    "name": "health",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/healthz",
                    "port": "health"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "ephemeral-storage": "256Mi",
                    "memory": "1Gi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "ephemeral-storage": "32Mi",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "mountPath": "/var/run/fugue/edge-identity",
                    "name": "identity",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/var/run/secrets/fugue-edge/route-reader",
                    "name": "route-reader",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/var/run/secrets/fugue-edge/bundle-verifier",
                    "name": "bundle-verifier",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/var/run/secrets/fugue-edge/inventory-identity",
                    "name": "inventory-identity",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/var/lib/fugue/edge",
                    "name": "worker-state"
                  },
                  {
                    "mountPath": "/var/lib/fugue-edge-front",
                    "name": "activation-state"
                  },
                  {
                    "mountPath": "/data",
                    "name": "caddy-data"
                  }
                ]
              },
              {
                "args": [
                  "printf '%s\\n' '{' '  admin 127.0.0.1:2019' '}' \u003e/config/Caddyfile; exec caddy run --adapter caddyfile --config /config/Caddyfile"
                ],
                "command": [
                  "/bin/sh",
                  "-ec"
                ],
                "image": "docker.io/library/caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d",
                "imagePullPolicy": "IfNotPresent",
                "name": "caddy",
                "ports": [
                  {
                    "containerPort": 18080,
                    "hostPort": 18080,
                    "name": "http-slot",
                    "protocol": "TCP"
                  },
                  {
                    "containerPort": 18443,
                    "hostPort": 18443,
                    "name": "https-slot",
                    "protocol": "TCP"
                  }
                ],
                "resources": {
                  "limits": {
                    "ephemeral-storage": "256Mi",
                    "memory": "1Gi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "ephemeral-storage": "32Mi",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "add": [
                      "NET_BIND_SERVICE"
                    ],
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "mountPath": "/config",
                    "name": "caddy-config"
                  },
                  {
                    "mountPath": "/data",
                    "name": "caddy-data"
                  }
                ]
              }
            ],
            "enableServiceLinks": false,
            "initContainers": [
              {
                "args": [
                  "umask 022\ntest -n \"${FUGUE_EDGE_IDENTITY_NODE_NAME}\"\nfor field in edge_group_id slot instance_uid release_epoch heartbeat_fenced; do\n  test -s \"/var/run/fugue/edge-identity-source/${field}\"\ndone\nprintf '%s\\n' \"${FUGUE_EDGE_IDENTITY_NODE_NAME}\" \u003e/var/run/fugue/edge-identity/edge_id\nfor field in edge_group_id slot instance_uid release_epoch heartbeat_fenced; do\n  cat \"/var/run/fugue/edge-identity-source/${field}\" \u003e\"/var/run/fugue/edge-identity/${field}\"\ndone\nchmod 0444 /var/run/fugue/edge-identity/*\n"
                ],
                "command": [
                  "/bin/sh",
                  "-ec"
                ],
                "env": [
                  {
                    "name": "FUGUE_EDGE_IDENTITY_NODE_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  }
                ],
                "image": "fugue-artifact://edge-worker",
                "imagePullPolicy": "IfNotPresent",
                "name": "edge-workload-identity",
                "resources": {
                  "limits": {
                    "ephemeral-storage": "8Mi",
                    "memory": "32Mi"
                  },
                  "requests": {
                    "cpu": "1m",
                    "ephemeral-storage": "1Mi",
                    "memory": "8Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "mountPath": "/var/run/fugue/edge-identity-source",
                    "name": "identity-source",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/var/run/fugue/edge-identity",
                    "name": "identity"
                  }
                ]
              }
            ],
            "nodeSelector": {
              "fugue.io/location-country-code": "@@GROUP@@",
              "fugue.io/role.edge": "true",
              "fugue.io/schedulable": "true"
            },
            "serviceAccountName": "@@SERVICE_ACCOUNT@@",
            "terminationGracePeriodSeconds": 45,
            "tolerations": [
              {
                "effect": "NoSchedule",
                "key": "fugue.io/dedicated",
                "operator": "Equal",
                "value": "edge"
              },
              {
                "effect": "NoSchedule",
                "key": "fugue.io/tenant",
                "operator": "Exists"
              }
            ],
            "volumes": [
              {
                "downwardAPI": {
                  "items": [
                    {
                      "fieldRef": {
                        "fieldPath": "metadata.labels['fugue.io/edge-group-id']"
                      },
                      "path": "edge_group_id"
                    },
                    {
                      "fieldRef": {
                        "fieldPath": "metadata.labels['fugue.io/edge-slot']"
                      },
                      "path": "slot"
                    },
                    {
                      "fieldRef": {
                        "fieldPath": "metadata.uid"
                      },
                      "path": "instance_uid"
                    },
                    {
                      "fieldRef": {
                        "fieldPath": "metadata.annotations['fugue.pro/source-commit']"
                      },
                      "path": "release_epoch"
                    },
                    {
                      "fieldRef": {
                        "fieldPath": "metadata.annotations['fugue.io/edge-heartbeat-fenced']"
                      },
                      "path": "heartbeat_fenced"
                    }
                  ]
                },
                "name": "identity-source"
              },
              {
                "emptyDir": {},
                "name": "identity"
              },
              {
                "name": "route-reader",
                "secret": {
                  "defaultMode": 384,
                  "items": [
                    {
                      "key": "token",
                      "path": "token"
                    }
                  ],
                  "secretName": "@@READER_SECRET@@"
                }
              },
              {
                "name": "bundle-verifier",
                "secret": {
                  "defaultMode": 384,
                  "items": [
                    {
                      "key": "keyring.json",
                      "path": "keyring.json"
                    }
                  ],
                  "secretName": "@@VERIFIER_SECRET@@"
                }
              },
              {
                "name": "inventory-identity",
                "secret": {
                  "defaultMode": 384,
                  "items": [
                    {
                      "key": "keyring.json",
                      "path": "keyring.json"
                    }
                  ],
                  "secretName": "@@INVENTORY_IDENTITY_A_SECRET@@"
                }
              },
              {
                "hostPath": {
                  "path": "/var/lib/fugue/edge-owned/@@GROUP_ID@@/slot-a",
                  "type": "DirectoryOrCreate"
                },
                "name": "worker-state"
              },
              {
                "hostPath": {
                  "path": "/var/lib/fugue/edge-owned/@@GROUP_ID@@/front",
                  "type": "DirectoryOrCreate"
                },
                "name": "activation-state"
              },
              {
                "emptyDir": {},
                "name": "caddy-config"
              },
              {
                "hostPath": {
                  "path": "/var/lib/fugue/edge-owned/@@GROUP_ID@@/caddy-slot-a",
                  "type": "DirectoryOrCreate"
                },
                "name": "caddy-data"
              }
            ]
          }
        },
        "updateStrategy": {
          "type": "OnDelete"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "annotations": {
          "fugue.pro/edge-worker-manifest-state": "materialization-ready",
          "fugue.pro/edge-worker-resource-set": "edge-worker-static-resources/v1"
        },
        "labels": {
