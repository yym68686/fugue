                  {
                    "containerPort": 28443,
                    "hostPort": 28443,
                    "name": "https-slot",
                    "protocol": "TCP"
                  }
                ],
                "resources": {
                  "limits": {
                    "ephemeral-storage": "256Mi",
                    "memory": "1Gi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "ephemeral-storage": "32Mi",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "add": [
