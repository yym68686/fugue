                    "mountPath": "/var/lib/fugue/edge",
                    "name": "worker-state"
                  },
                  {
                    "mountPath": "/var/lib/fugue-edge-front",
                    "name": "activation-state"
                  },
                  {
                    "mountPath": "/data",
                    "name": "caddy-data"
                  }
                ]
              },
              {
                "args": [
                  "printf '%s\\n' '{' '  admin 127.0.0.1:2019' '}' \u003e/config/Caddyfile; exec caddy run --adapter caddyfile --config /config/Caddyfile"
                ],
                "command": [
                  "/bin/sh",
                  "-ec"
                ],
                "image": "docker.io/library/caddy@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d",
                "imagePullPolicy": "IfNotPresent",
                "name": "caddy",
                "ports": [
                  {
                    "containerPort": 28080,
                    "hostPort": 28080,
                    "name": "http-slot",
