# Digest pins the multi-architecture builder so the backup materializer lane
# cannot move its toolchain implicitly.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine@sha256:56961d79ea8129efddcc0b8643fd8a5416b4e6228cfd477e3fd61deb2672c587 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

# Copy only the independently compiled, observation-only materializer closure.
# Signers, stores, API handlers, TokenReview, Kubernetes SDKs, writers, backup
# execution, registry clients, and every other Fugue process remain absent.
COPY cmd/fugue-backup-materializer ./cmd/fugue-backup-materializer
COPY internal/backupcontrol ./internal/backupcontrol
COPY internal/backupmaterializer/agent ./internal/backupmaterializer/agent
COPY internal/backupmaterializer/client ./internal/backupmaterializer/client
COPY internal/backupmaterializer/contract ./internal/backupmaterializer/contract
COPY internal/backupmaterializer/materialization ./internal/backupmaterializer/materialization
COPY internal/backupmaterializer/reconcile ./internal/backupmaterializer/reconcile
COPY internal/backupmaterializer/reconciler ./internal/backupmaterializer/reconciler
COPY internal/backupmaterializer/secretreader ./internal/backupmaterializer/secretreader

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -buildvcs=false -ldflags='-s -w' \
    -o /out/fugue-backup-materializer ./cmd/fugue-backup-materializer

FROM scratch
LABEL org.opencontainers.image.title="fugue-backup-materializer" \
      org.opencontainers.image.description="Observation-only Fugue backup Secret materializer"
COPY --from=build /out/fugue-backup-materializer /usr/local/bin/fugue-backup-materializer
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/fugue-backup-materializer"]
