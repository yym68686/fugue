# Digest pins the multi-architecture builder so the image-plane lane cannot
# move its toolchain implicitly when another component releases.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine@sha256:56961d79ea8129efddcc0b8643fd8a5416b4e6228cfd477e3fd61deb2672c587 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download

# Copy only the image-cache dependency closure. A source change in API,
# controller, backup, edge, or release-control therefore cannot invalidate or
# silently widen this component image.
COPY cmd/fugue-image-cache ./cmd/fugue-image-cache
COPY internal/imagecacheusage ./internal/imagecacheusage

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -buildvcs=false -ldflags='-s -w' \
    -o /out/fugue-image-cache ./cmd/fugue-image-cache

FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d
LABEL org.opencontainers.image.title="fugue-image-cache" \
      org.opencontainers.image.description="Fugue node-local OCI image-plane cache"
WORKDIR /app
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/fugue-image-cache /usr/local/bin/fugue-image-cache
EXPOSE 5000
ENTRYPOINT ["/usr/local/bin/fugue-image-cache"]
