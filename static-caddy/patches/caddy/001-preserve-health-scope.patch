+func TestActiveHandlersIndependentPassiveShared(t *testing.T) {
+	bad := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(500) })
+	_, a, checkA := scopeLab(t, bad)
+	_, b, checkB := scopeLab(t, bad)
+	b.Host = a.Host
+	checkA()
+	checkB()
+	if !a.healthy() || !b.healthy() {
+		t.Fatal("one failure per handler ejected an upstream")
+	}
+	checkA()
+	if a.healthy() || !b.healthy() {
+		t.Fatal("active health leaked across handlers")
+	}
+	if err := a.Host.countFail(1); err != nil {
+		t.Fatal(err)
+	}
+	if b.Host.Fails() != 1 {
+		t.Fatal("passive sharing changed")
+	}
+}
+
+func TestActiveOverlapAndCanceledCheck(t *testing.T) {
+	started, release := make(chan struct{}), make(chan struct{})
+	var calls atomic.Int32
+	h, u, check := scopeLab(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		close(started)
+		<-release
+		w.WriteHeader(500)
+	}))
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() { defer wg.Done(); check() }()
+	<-started
+	check()
+	if calls.Load() != 1 {
+		t.Fatal("overlapping check reached backend")
+	}
+	close(release)
+	wg.Wait()
+	if !u.healthy() {
+		t.Fatal("overlap counted twice")
+	}
+	ctx, cancel := context.WithCancel(h.ctx.Context)
+	cancel()
+	h.ctx.Context = ctx
+	if err := h.doActiveHealthCheck(DialInfo{}, u.Dial, u.Dial, u); err == nil {
+		t.Fatal("canceled check started")
+	}
+	if calls.Load() != 1 || !u.healthy() {
+		t.Fatal("canceled check changed health")
+	}
+}
