+func TestHealthMetricsHandlerAndCleanup(t *testing.T) {
+	serve := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(403) })
+	hA, a, _ := scopeLab(t, serve)
+	hB, b, _ := scopeLab(t, serve)
+	b.Dial = a.Dial
+	b.Host = a.Host
+	a.setHealthy(false)
+	registry := prometheus.NewPedanticRegistry()
+	ca, cb := newUpstreamHealthCollector(hA), newUpstreamHealthCollector(hB)
+	registry.MustRegister(ca, cb)
+	read := func() map[string]float64 {
+		families, err := registry.Gather()
+		if err != nil {
+			t.Fatal(err)
+		}
+		values := map[string]float64{}
+		for _, f := range families {
+			if f.GetName() == "caddy_reverse_proxy_upstreams_healthy" {
+				for _, m := range f.Metric {
+					for _, l := range m.Label {
+						if l.GetName() == "handler" {
+							values[l.GetValue()] = m.Gauge.GetValue()
+						}
+					}
+				}
+			}
+		}
+		return values
+	}
+	for i := 0; i < 2; i++ {
+		v := read()
+		if len(v) != 2 || v[hA.healthHandlerID] != 0 || v[hB.healthHandlerID] != 1 {
+			t.Fatalf("handler metrics: %v", v)
+		}
+	}
+	registry.Unregister(ca)
+	if v := read(); len(v) != 1 || v[hB.healthHandlerID] != 1 {
+		t.Fatalf("cleanup changed another handler: %v", v)
+	}
+	a.setHealthy(true)
+	registry.MustRegister(ca)
+	if v := read(); len(v) != 2 || v[hA.healthHandlerID] != 1 {
+		t.Fatalf("replacement: %v", v)
+	}
+}
