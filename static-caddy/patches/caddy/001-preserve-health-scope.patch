+package reverseproxy
+
+import (
+	"errors"
+	"io"
+	"strings"
+	"testing"
+)
+
+type clientReadFailure struct{ cause error }
+
+func (b clientReadFailure) Read([]byte) (int, error) { return 0, b.cause }
+func (b clientReadFailure) Close() error             { return nil }
+
+func TestDownstreamBodyFailureProvenance(t *testing.T) {
+	cause := errors.New("client reset during upload")
+	b := &bodyNopCloserIfNotRead{ReadCloser: clientReadFailure{cause: cause}}
+	_, err := io.Copy(io.Discard, b)
+	var downstream downstreamRequestBodyError
+	if !errors.As(err, &downstream) || !errors.Is(err, cause) {
+		t.Fatalf("lost client error provenance: %v", err)
+	}
+	if err.Error() != cause.Error() {
+		t.Fatalf("changed original log message: %v", err)
+	}
+}
+
+func TestDownstreamBodyNormalEOF(t *testing.T) {
+	b := &bodyNopCloserIfNotRead{ReadCloser: io.NopCloser(strings.NewReader("complete upload"))}
+	data, err := io.ReadAll(b)
+	if err != nil || string(data) != "complete upload" {
+		t.Fatalf("normal body changed: %q %v", data, err)
+	}
+	n, err := b.Read(make([]byte, 1))
+	if n != 0 || err != io.EOF {
+		t.Fatalf("EOF contract changed: %d %v", n, err)
+	}
+}
