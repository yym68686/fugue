+// handler's scope. Passive health and request counts remain shared by Host.
+func (u *Upstream) recordActiveHealth(passed bool, passes, fails int) bool {
+	u.activeHealthMu.Lock()
+	defer u.activeHealthMu.Unlock()
+	if passed {
+		u.activeFails = 0
+		if u.activePasses < passes {
+			u.activePasses++
