+func TestActualProbeEvidence(t *testing.T) {
+	var checkID string
+	h, u, check := scopeLab(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		checkID = r.Header.Get("X-Fugue-Health-Check-ID")
+		w.WriteHeader(403)
+	}))
+	core, logs := observer.New(zap.InfoLevel)
+	h.HealthChecks.Active.logger = zap.New(core)
+	check()
+	entries := logs.FilterMessage("active health probe completed").All()
+	if len(entries) != 1 {
+		t.Fatalf("got %d completion records", len(entries))
+	}
+	f := entries[0].ContextMap()
+	if f["check_id"] != checkID || checkID == "" || f["outcome"] != "passed" || f["handler"] != h.healthHandlerID || f["host"] != u.Dial || f["local"] == "" || f["remote"] == "" {
+		t.Fatalf("incomplete evidence: %v", f)
+	}
+}
