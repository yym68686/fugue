+package reverseproxy
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"net"
+	"net/http/httptrace"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"go.uber.org/zap"
+)
+
+var activeProbeSequence atomic.Uint64
+
+// Only control metadata is retained: never URLs, headers, bodies or credentials.
+type activeProbeObservation struct {
+	mu                                            sync.Mutex
+	id, handler, host, phase, outcome, errorClass string
+	local, remote                                 string
+	started                                       time.Time
+	timings                                       map[string]float64
+	status                                        int
+	reused                                        bool
+}
+
+func newActiveProbeObservation(handler, host string) *activeProbeObservation {
+	return &activeProbeObservation{id: fmt.Sprintf("%x-%d", healthProcessEpoch, activeProbeSequence.Add(1)),
+		handler: handler, host: host, started: time.Now(), phase: "get_connection", outcome: "internal_error", timings: make(map[string]float64)}
+}
+
+func (o *activeProbeObservation) setPhase(phase string) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.phase = phase
+}
+func (o *activeProbeObservation) setOutcome(outcome string) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.outcome = outcome
+}
+func (o *activeProbeObservation) setStatus(status int) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.status = status
+}
+func (o *activeProbeObservation) setError(err error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	var ne net.Error
+	switch {
+	case errors.Is(err, context.Canceled):
+		o.errorClass = "canceled"
+	case errors.As(err, &ne) && ne.Timeout():
+		o.errorClass = "timeout"
+	default:
+		o.errorClass = fmt.Sprintf("%T", err)
+	}
+}
+
+func (o *activeProbeObservation) mark(name, phase string) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.timings[name] = float64(time.Since(o.started)) / float64(time.Millisecond)
+	o.phase = phase
+}
+
+func (o *activeProbeObservation) context(ctx context.Context) context.Context {
+	return httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{
+		DNSStart:     func(httptrace.DNSStartInfo) { o.setPhase("dns") },
+		ConnectStart: func(string, string) { o.setPhase("tcp_connect") },
+		ConnectDone: func(_, _ string, err error) {
+			if err == nil {
+				o.mark("connect_ms", "get_connection")
+			}
+		},
+		TLSHandshakeStart: func() { o.setPhase("tls_handshake") },
+		TLSHandshakeDone: func(_ tls.ConnectionState, err error) {
+			if err == nil {
+				o.mark("tls_ms", "get_connection")
+			}
+		},
+		GotConn: func(info httptrace.GotConnInfo) {
+			o.mu.Lock()
+			defer o.mu.Unlock()
+			o.local, o.remote, o.reused = info.Conn.LocalAddr().String(), info.Conn.RemoteAddr().String(), info.Reused
+			o.timings["got_connection_ms"] = float64(time.Since(o.started)) / float64(time.Millisecond)
+			o.phase = "write_request"
+		},
+		WroteRequest: func(info httptrace.WroteRequestInfo) {
+			if info.Err == nil {
+				o.mark("write_completed_ms", "read_headers")
+			} else {
+				o.setError(info.Err)
+			}
+		},
+		GotFirstResponseByte: func() { o.mark("first_byte_ms", "read_headers") },
+	})
+}
+
+func (o *activeProbeObservation) finish(logger *zap.Logger, upstream *Upstream) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	passes, fails := upstream.activeHealthStreaks()
+	logger.Info("active health probe completed",
+		zap.String("handler", o.handler), zap.String("check_id", o.id), zap.String("host", o.host),
+		zap.Int64("started_at_unix_ms", o.started.UnixMilli()), zap.Float64("duration_ms", float64(time.Since(o.started))/float64(time.Millisecond)),
+		zap.String("outcome", o.outcome), zap.String("phase", o.phase), zap.String("error_class", o.errorClass),
+		zap.String("local", o.local), zap.String("remote", o.remote), zap.Bool("connection_reused", o.reused),
+		zap.Int("status", o.status), zap.Any("timings_ms", o.timings), zap.Int("consecutive_passes", passes), zap.Int("consecutive_fails", fails),
+		zap.Bool("active_healthy", upstream.healthy()))
+}
