+func scopeLab(t *testing.T, serve http.Handler) (*Handler, *Upstream, func()) {
+	t.Helper()
+	s := httptest.NewServer(serve)
+	t.Cleanup(s.Close)
+	ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+	t.Cleanup(cancel)
+	events := &caddyevents.App{}
+	if err := events.Provision(ctx); err != nil {
+		t.Fatal(err)
+	}
+	h := &Handler{ctx: ctx, events: events, logger: zap.NewNop(), healthHandlerID: nextHealthHandlerID(), HealthChecks: &HealthChecks{Active: &ActiveHealthChecks{
+		Method: "GET", Path: "/health", ExpectStatus: 403, Fails: 2, Passes: 2, logger: zap.NewNop(), httpClient: &http.Client{Timeout: time.Second},
+	}}}
+	u := &Upstream{Dial: strings.TrimPrefix(s.URL, "http://"), Host: new(Host)}
+	h.Upstreams = UpstreamPool{u}
+	return h, u, func() {
+		if err := h.doActiveHealthCheck(DialInfo{Upstream: u, Address: u.Dial, Network: "tcp"}, u.Dial, u.Dial, u); err != nil {
+			t.Error(err)
+		}
+	}
+}
+
+func TestActiveConsecutiveResults(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		initial bool
+		codes   []int
+		want    []bool
+	}{
+		{"failures", true, []int{500, 403, 500, 500, 403, 500, 403, 403}, []bool{true, true, true, false, false, false, false, true}},
+		{"passes", false, []int{403, 500, 403, 403}, []bool{false, false, false, true}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var code atomic.Int32
+			_, u, check := scopeLab(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(int(code.Load())) }))
+			u.setHealthy(tc.initial)
+			for i, status := range tc.codes {
+				code.Store(int32(status))
+				check()
+				if u.healthy() != tc.want[i] {
+					t.Fatalf("step %d: healthy=%v want=%v", i, u.healthy(), tc.want[i])
+				}
+			}
+		})
+	}
+}
