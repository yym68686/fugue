+// Copyright 2026 The Fugue Authors.
+// SPDX-License-Identifier: BSD-3-Clause
+// Optional metadata observations do not change HTTP/2 flow control.
+package http2
+
+import (
+	"context"
+	"sync/atomic"
+	"time"
+)
+
+type fugueObservationKey struct{}
+type fugueSendKey struct{}
+
+var fugueConnectionSequence atomic.Uint64
+
+type FugueSnapshot struct {
+	ConnectionID        uint64
+	StreamID            uint32
+	StartedAt           time.Time
+	ElapsedMS           float64
+	DataBytes           int64
+	ConsumedBytes       int64
+	DataFrames          uint64
+	FirstDataMS         *float64
+	LastDataMS          *float64
+	MaxUnreadBytes      int64
+	StreamCredit        int32
+	ConnectionCredit    int32
+	WindowUpdatesQueued uint64
+	Dropped             uint64
+}
+type FugueObservation struct {
+	start                                                        time.Time
+	v                                                            FugueSnapshot // immutable identity, initialized before publication
+	connectionCredit                                             *atomic.Int32
+	dataBytes, consumedBytes, firstDataNS, lastDataNS, maxUnread atomic.Int64
+	frames, windows                                              atomic.Uint64
+	streamCredit                                                 atomic.Int32
+}
+
+func FugueRequestObservation(ctx context.Context) *FugueObservation {
+	v, _ := ctx.Value(fugueObservationKey{}).(*FugueObservation)
+	return v
+}
+
+// Independent atomic counters are deliberately not an atomic network snapshot.
+// They cannot prove credit reached the peer. No observation lock touches the
+// HTTP/2 serve loop or the application reader.
+func (o *FugueObservation) Snapshot() (FugueSnapshot, bool) {
+	if o == nil {
+		return FugueSnapshot{}, false
+	}
+	v := o.v
+	v.ElapsedMS = float64(time.Since(o.start)) / float64(time.Millisecond)
+	v.DataBytes = o.dataBytes.Load()
+	v.ConsumedBytes = o.consumedBytes.Load()
+	v.DataFrames = o.frames.Load()
+	v.MaxUnreadBytes = o.maxUnread.Load()
+	v.StreamCredit = o.streamCredit.Load()
+	v.ConnectionCredit = o.connectionCredit.Load()
+	v.WindowUpdatesQueued = o.windows.Load()
+	if ns := o.firstDataNS.Load(); ns > 0 {
+		ms := float64(ns) / float64(time.Millisecond)
+		v.FirstDataMS = &ms
+	}
+	if ns := o.lastDataNS.Load(); ns > 0 {
+		ms := float64(ns) / float64(time.Millisecond)
+		v.LastDataMS = &ms
+	}
+	return v, true
+}
+func (o *FugueObservation) data(n int, credit int32) {
+	if o == nil {
+		return
+	}
+	total := o.dataBytes.Add(int64(n))
+	o.frames.Add(1)
+	o.streamCredit.Store(credit)
+	if n > 0 {
+		at := time.Since(o.start).Nanoseconds()
+		if at < 1 {
+			at = 1
+		}
+		o.firstDataNS.CompareAndSwap(0, at)
+		o.lastDataNS.Store(at)
+	}
+	unread := total - o.consumedBytes.Load()
+	for old := o.maxUnread.Load(); unread > old; old = o.maxUnread.Load() {
+		if o.maxUnread.CompareAndSwap(old, unread) {
+			break
+		}
+	}
+}
+func (o *FugueObservation) consumed(n int) {
+	if o != nil && n > 0 {
+		o.consumedBytes.Add(int64(n))
+	}
+}
+func (o *FugueObservation) window(credit int32, sent bool) {
+	if o != nil {
+		o.streamCredit.Store(credit)
+		if sent {
+			o.windows.Add(1)
+		}
+	}
+}
+
+// FugueSendObserver must be bounded and non-blocking. A cancelled wait is not
+// recorded as receiving credit. Hooks never inspect payload or headers.
+type FugueSendObserver interface {
+	HTTP2SendWait(begin bool, granted bool, stream uint32, streamCredit, connectionCredit int32)
+}
+
+func WithFugueSendObserver(ctx context.Context, o FugueSendObserver) context.Context {
+	return context.WithValue(ctx, fugueSendKey{}, o)
+}
+func fugueSendObserver(ctx context.Context) FugueSendObserver {
+	o, _ := ctx.Value(fugueSendKey{}).(FugueSendObserver)
+	return o
+}
