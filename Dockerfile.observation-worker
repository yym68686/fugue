FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY assets ./assets
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -o /out/fugue-observation-worker ./cmd/fugue-observation-worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=build /out/fugue-observation-worker /usr/local/bin/fugue-observation-worker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/fugue-observation-worker"]
