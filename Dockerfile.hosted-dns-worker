FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/fugue-hosted-dns-worker ./cmd/fugue-hosted-dns-worker
COPY internal ./internal
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -o /out/fugue-hosted-dns-worker ./cmd/fugue-hosted-dns-worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=build /out/fugue-hosted-dns-worker /usr/local/bin/fugue-hosted-dns-worker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/fugue-hosted-dns-worker"]
