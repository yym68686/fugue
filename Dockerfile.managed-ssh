FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -o /out/fugue-managed-ssh ./cmd/fugue-managed-ssh && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -o /out/fugue-ssh-helper ./cmd/fugue-ssh-helper && \
    sha256sum /out/fugue-ssh-helper > /out/fugue-ssh-helper.sha256

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/fugue-managed-ssh /usr/local/bin/fugue-managed-ssh
COPY --from=build /out/fugue-ssh-helper /usr/local/bin/fugue-ssh-helper
COPY --from=build /out/fugue-ssh-helper.sha256 /usr/local/share/fugue-ssh-helper.sha256
ENTRYPOINT ["/usr/local/bin/fugue-managed-ssh"]
