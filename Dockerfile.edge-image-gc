FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -o /out/fugue-edge-image-gc ./cmd/fugue-edge-image-gc
FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=build /out/fugue-edge-image-gc /usr/local/bin/fugue-edge-image-gc
ENTRYPOINT ["/usr/local/bin/fugue-edge-image-gc"]
