FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY assets ./assets
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -o /out/fugue-database-import-worker ./cmd/fugue-database-import-worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates 'postgresql17-client>=17.11' \
    && LC_ALL=C psql --help=commands | grep -Fq '\restrict'
COPY --from=build /out/fugue-database-import-worker /usr/local/bin/fugue-database-import-worker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/fugue-database-import-worker"]
