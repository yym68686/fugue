+++ b/pkg/specs/baked_manager_test.go
@@ -0,0 +1,86 @@
+package specs
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	apiv1 "github.com/cloudnative-pg/cloudnative-pg/api/v1"
+	"github.com/cloudnative-pg/cloudnative-pg/internal/configuration"
+	"github.com/cloudnative-pg/cloudnative-pg/pkg/bakedmanager"
+	"github.com/cloudnative-pg/cloudnative-pg/pkg/utils"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/equality"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func TestBakedManagerPodAndJob(t *testing.T) {
+	original := bakedmanager.Current
+	t.Cleanup(func() { bakedmanager.Current = original })
+	image := "registry.invalid/postgres:18.3-baked@sha256:" + strings.Repeat("a", 64)
+	copy := *original
+	copy.Images = []string{image}
+	copy.DefaultImage = image
+	cluster := apiv1.Cluster{ObjectMeta: metav1.ObjectMeta{Name: "sample", Namespace: "tenant"},
+		Spec: apiv1.ClusterSpec{ImageName: image, Bootstrap: &apiv1.BootstrapConfiguration{InitDB: &apiv1.BootstrapInitDB{}},
+			Resources: corev1.ResourceRequirements{Requests: corev1.ResourceList{
+				corev1.ResourceCPU: resource.MustParse("5m"), corev1.ResourceMemory: resource.MustParse("10Mi")}}},
+		Status: apiv1.ClusterStatus{Image: image}}
+	empty := *original
+	empty.Images = nil
+	bakedmanager.Current = &empty
+	legacy, err := NewInstance(context.Background(), cluster, 1, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	bakedmanager.Current = &copy
+	baked, err := NewInstance(context.Background(), cluster, 1, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := legacy.DeepCopy()
+	want.Spec.InitContainers = []corev1.Container{}
+	want.Spec.Containers[0].Command[0] = bakedmanager.Entrypoint
+	if !equality.Semantic.DeepEqual(want.Spec, baked.Spec) {
+		t.Fatal("baked mode changed fields outside bootstrap and manager command")
+	}
+	var stored corev1.PodSpec
+	if err := json.Unmarshal([]byte(baked.Annotations[utils.PodSpecAnnotationName]), &stored); err != nil {
+		t.Fatal(err)
+	}
+	if !equality.Semantic.DeepEqual(stored, baked.Spec) {
+		t.Fatal("stored PodSpec lost baked mode")
+	}
+	if source, err := GetBootstrapControllerImageName(*baked); err != nil || source != configuration.Current.OperatorImageName {
+		t.Fatalf("missing effective manager identity: %q %v", source, err)
+	}
+	if baked.Spec.Containers[0].Resources.Requests.Memory().Value() != 10*1024*1024 {
+		t.Fatal("baked manager imposed a scheduling memory floor")
+	}
+	job := CreatePrimaryJobViaInitdb(cluster, 1)
+	if len(job.Spec.Template.Spec.InitContainers) != 0 || job.Spec.Template.Spec.Containers[0].Command[0] != bakedmanager.Entrypoint {
+		t.Fatal("initdb still copies the instance manager")
+	}
+	// A mutable tag, even one with a trusted name, must remain on the old path.
+	cluster.Status.Image = "registry.invalid/postgres:18.3-baked"
+	old, err := NewInstance(context.Background(), cluster, 1, true)
+	if err != nil || len(old.Spec.InitContainers) != 1 || old.Spec.Containers[0].Command[0] != "/controller/manager" {
+		t.Fatalf("unapproved image lost bootstrap: %v", err)
+	}
+	broken := baked.DeepCopy()
+	broken.Spec.Containers[0].Command[0] = "/not-a-manager"
+	if _, err := GetBootstrapControllerImageName(*broken); err == nil {
+		t.Fatal("accepted a missing manager")
+	}
+	// Other initialization steps must survive; caller-owned command slices must not change.
+	pod := legacy.Spec.DeepCopy()
+	pod.InitContainers = append(pod.InitContainers, corev1.Container{Name: "extension"})
+	before := append([]string(nil), pod.Containers[0].Command...)
+	useBakedInstanceManager(pod, image)
+	if len(pod.InitContainers) != 1 || pod.InitContainers[0].Name != "extension" || !reflect.DeepEqual(before, legacy.Spec.Containers[0].Command) {
+		t.Fatal("baked mode changed extensions or caller-owned command")
+	}
+}
