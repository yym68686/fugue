 )
 
@@ -72,6 +73,17 @@ func GetPostgresImageName(pod corev1.Pod) (string, error) {
 
 // GetBootstrapControllerImageName get the controller image name used to bootstrap a Pod
 func GetBootstrapControllerImageName(pod corev1.Pod) (string, error) {
+	// Approved baked images contain exactly the same original manager binaries
+	// as this controller's /operator inventory. CI refuses catalogs from a
+	// different inventory; release guards independently fence operand hashes.
+	if hasBakedInstanceManager(pod) {
+		for _, container := range pod.Spec.InitContainers {
+			if container.Name == BootstrapControllerContainerName {
+				return container.Image, nil
+			}
+		}
+		return configuration.Current.OperatorImageName, nil
+	}
 	return GetInitContainerImageName(pod, BootstrapControllerContainerName)
 }
 
