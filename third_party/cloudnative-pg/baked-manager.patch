+++ b/pkg/bakedmanager/catalog_test.go
@@ -0,0 +1,40 @@
+package bakedmanager
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestBakedManagerCatalog(t *testing.T) {
+	value, err := Parse(embedded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	image := "registry.invalid/postgres:18.3@sha256:" + strings.Repeat("a", 64)
+	value.Images = []string{image}
+	value.DefaultImage = image
+	data, _ := json.Marshal(value)
+	parsed, err := Parse(data)
+	if err != nil || !parsed.Approved(image) || parsed.Approved("registry.invalid/postgres:18.3") {
+		t.Fatalf("immutable approval failed: %v", err)
+	}
+	for _, mutate := range []func(*Catalog){
+		func(c *Catalog) { c.Images = []string{"registry.invalid/postgres:18.3"} },
+		func(c *Catalog) { c.Images = append(c.Images, image) },
+		func(c *Catalog) { c.DefaultImage = "not-approved" },
+		func(c *Catalog) { c.ManagerSHA256 = map[string]string{"manager_amd64": "bad"} },
+		func(c *Catalog) { c.Schema = "unknown" },
+	} {
+		var invalid Catalog
+		_ = json.Unmarshal(data, &invalid)
+		mutate(&invalid)
+		bad, _ := json.Marshal(invalid)
+		if _, err := Parse(bad); err == nil {
+			t.Fatalf("accepted invalid catalog: %s", bad)
+		}
+	}
+	if _, err := Parse(append(data, []byte(` {}`)...)); err == nil {
+		t.Fatal("accepted trailing JSON")
+	}
+}
