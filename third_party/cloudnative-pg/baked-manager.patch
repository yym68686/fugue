new file mode 100644
index 0000000..7827c40
--- /dev/null
+++ b/pkg/specs/baked_manager.go
@@ -0,0 +1,38 @@
+package specs
+
+import (
+	"github.com/cloudnative-pg/cloudnative-pg/pkg/bakedmanager"
+	corev1 "k8s.io/api/core/v1"
+)
+
+// useBakedInstanceManager changes only trusted images and only the generated
+// bootstrap/manager command. Keep /controller writable: CNPG also stores
+// certificates, WAL helpers and atomic in-place manager upgrades there.
+func useBakedInstanceManager(pod *corev1.PodSpec, image string) {
+	if !bakedmanager.Current.Approved(image) {
+		return
+	}
+	for i := range pod.Containers {
+		container := &pod.Containers[i]
+		if container.Image == image && len(container.Command) > 0 && container.Command[0] == "/controller/manager" {
+			container.Command = append([]string{bakedmanager.Entrypoint}, container.Command[1:]...)
+		}
+	}
+	init := make([]corev1.Container, 0, len(pod.InitContainers))
+	for _, container := range pod.InitContainers {
+		if container.Name != BootstrapControllerContainerName {
+			init = append(init, container)
+		}
+	}
+	pod.InitContainers = init
+}
+
+func hasBakedInstanceManager(pod corev1.Pod) bool {
+	for _, container := range pod.Spec.Containers {
+		if container.Name == PostgresContainerName && bakedmanager.Current.Approved(container.Image) &&
+			len(container.Command) > 0 && container.Command[0] == bakedmanager.Entrypoint {
+			return true
+		}
+	}
+	return false
+}
