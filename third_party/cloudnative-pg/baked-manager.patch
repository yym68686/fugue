@@ -0,0 +1,41 @@
+package controller
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	apiv1 "github.com/cloudnative-pg/cloudnative-pg/api/v1"
+	"github.com/cloudnative-pg/cloudnative-pg/internal/configuration"
+	"github.com/cloudnative-pg/cloudnative-pg/pkg/bakedmanager"
+	"github.com/cloudnative-pg/cloudnative-pg/pkg/specs"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func TestBakedManagerNoSpuriousRollout(t *testing.T) {
+	original := bakedmanager.Current
+	oldConfiguration := configuration.Current
+	t.Cleanup(func() { bakedmanager.Current = original; configuration.Current = oldConfiguration })
+	catalog := *original
+	image := "registry.invalid/postgres:18.3-baked@sha256:" + strings.Repeat("a", 64)
+	catalog.Images = []string{image}
+	bakedmanager.Current = &catalog
+	cfg := *configuration.Current
+	cfg.EnableInstanceManagerInplaceUpdates = false
+	configuration.Current = &cfg
+	cluster := apiv1.Cluster{ObjectMeta: metav1.ObjectMeta{Name: "sample", Namespace: "tenant"},
+		Spec: apiv1.ClusterSpec{ImageName: image}, Status: apiv1.ClusterStatus{Image: image}}
+	cluster.SetDefaults()
+	pod, err := specs.NewInstance(context.Background(), cluster, 1, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	roll, err := checkPodSpecIsOutdated(context.Background(), pod, &cluster)
+	if err != nil || roll.required {
+		t.Fatalf("baked pod triggers rollout: %+v %v", roll, err)
+	}
+	roll, err = checkPodBootstrapImage(context.Background(), pod, &cluster)
+	if err != nil || roll.required {
+		t.Fatalf("baked pod lost manager identity: %+v %v", roll, err)
+	}
+}
diff --git a/pkg/bakedmanager/catalog.go b/pkg/bakedmanager/catalog.go
new file mode 100644
index 0000000..115d477
--- /dev/null
+++ b/pkg/bakedmanager/catalog.go
@@ -0,0 +1,86 @@
+// Package bakedmanager binds preinstalled instance managers to immutable,
+// CI-verified PostgreSQL images. Arbitrary image labels are never trusted.
+package bakedmanager
+
+import (
+	"bytes"
+	_ "embed"
+	"encoding/json"
+	"fmt"
+	"io"
+	"regexp"
+)
+
+const Entrypoint = "/usr/local/bin/fugue-cnpg-manager"
+
+//go:embed images.json
+var embedded []byte
+
+type Catalog struct {
+	Schema        string            `json:"schema"`
+	DefaultImage  string            `json:"defaultImage"`
+	ManagerImage  string            `json:"managerImage"`
+	ManagerSHA256 map[string]string `json:"managerSHA256"`
+	Images        []string          `json:"images"`
+}
+
+var immutable = regexp.MustCompile(`^[^\s@]+@sha256:[0-9a-f]{64}$`)
+var taggedImmutable = regexp.MustCompile(`^[^\s@]+:[^/:\s@]+@sha256:[0-9a-f]{64}$`)
+var hash = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var Current = mustParse(embedded)
+
+// Parse rejects incomplete or ambiguous catalogs before the controller starts.
+func Parse(data []byte) (*Catalog, error) {
+	var value Catalog
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&value); err != nil {
+		return nil, err
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return nil, fmt.Errorf("trailing instance-manager catalog content")
+	}
+	if value.Schema != "fugue.cnpg.baked-manager.v1" || !immutable.MatchString(value.ManagerImage) ||
+		len(value.ManagerSHA256) != 2 || !hash.MatchString(value.ManagerSHA256["manager_amd64"]) ||
+		!hash.MatchString(value.ManagerSHA256["manager_arm64"]) || len(value.Images) > 256 {
+		return nil, fmt.Errorf("invalid instance-manager catalog")
+	}
+	seen := make(map[string]bool, len(value.Images))
+	for _, image := range value.Images {
+		if !taggedImmutable.MatchString(image) || seen[image] {
+			return nil, fmt.Errorf("instance-manager image must be unique, tagged and digest-pinned: %q", image)
+		}
+		seen[image] = true
+	}
+	if value.DefaultImage != "" && !seen[value.DefaultImage] {
+		return nil, fmt.Errorf("default image is not approved")
+	}
+	return &value, nil
+}
+
+func mustParse(data []byte) *Catalog {
+	value, err := Parse(data)
+	if err != nil {
+		panic(err)
+	}
+	return value
+}
+
+func (c *Catalog) Approved(image string) bool {
+	for _, approved := range c.Images {
+		if image == approved {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *Catalog) Default(fallback string) string {
+	if c.DefaultImage == "" {
+		return fallback
+	}
+	return c.DefaultImage
+}
+
+// EmbeddedJSON exposes the exact build input for independent artifact verification.
+func EmbeddedJSON() []byte { return append([]byte(nil), embedded...) }
diff --git a/pkg/bakedmanager/catalog_test.go b/pkg/bakedmanager/catalog_test.go
