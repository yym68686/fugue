{
  "apiVersion": "release.fugue.dev/v2",
  "kind": "ComponentResourceSet",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "fugue-storage-audit-worker", "namespace": "fugue-system"},
      "spec": {
        "minReadySeconds": 5,
        "progressDeadlineSeconds": 180,
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "selector": {
          "matchLabels": {"app.kubernetes.io/name": "fugue-storage-audit-worker"}
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {"maxUnavailable": 0, "maxSurge": 1}
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "fugue-storage-audit-worker",
              "app.kubernetes.io/component": "storage-audit-worker"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 20,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "seccompProfile": {"type": "RuntimeDefault"}
            },
            "containers": [
              {
                "name": "storage-audit-worker",
                "image": "placeholder",
                "ports": [{"name": "metrics", "containerPort": 9090}],
                "env": [
                  {
                    "name": "FUGUE_STORAGE_AUDIT_DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {"name": "fugue-storage-audit-worker-database", "key": "database-url"}
                    }
                  },
                  {"name": "GOMEMLIMIT", "value": "96MiB"}
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {"drop": ["ALL"]}
                },
                "resources": {
                  "requests": {"cpu": "25m", "memory": "32Mi"},
                  "limits": {"cpu": "250m", "memory": "128Mi"}
                },
                "startupProbe": {
                  "httpGet": {"path": "/healthz", "port": "metrics"},
                  "periodSeconds": 3,
                  "failureThreshold": 14
                },
                "livenessProbe": {
                  "httpGet": {"path": "/healthz", "port": "metrics"},
                  "timeoutSeconds": 3,
                  "periodSeconds": 15
                },
                "readinessProbe": {
                  "httpGet": {"path": "/readyz", "port": "metrics"},
                  "timeoutSeconds": 3,
                  "periodSeconds": 5
                }
              }
            ]
          }
        }
      }
    }
  ]
}
