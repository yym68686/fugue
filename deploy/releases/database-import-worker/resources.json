{
  "apiVersion": "release.fugue.dev/v2",
  "kind": "ComponentResourceSet",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "fugue-database-import-worker", "namespace": "fugue-system"},
      "spec": {
        "minReadySeconds": 5,
        "progressDeadlineSeconds": 180,
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "selector": {"matchLabels": {"app.kubernetes.io/name": "fugue-database-import-worker"}},
        "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxSurge": 1, "maxUnavailable": 0}},
        "template": {
          "metadata": {"labels": {"app.kubernetes.io/name": "fugue-database-import-worker", "app.kubernetes.io/component": "database-import-worker"}},
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 25,
            "securityContext": {"runAsNonRoot": true, "runAsUser": 65532, "runAsGroup": 65532, "fsGroup": 65532, "seccompProfile": {"type": "RuntimeDefault"}},
            "volumes": [{"name": "scratch", "emptyDir": {"sizeLimit": "384Mi"}}],
            "containers": [
              {
                "name": "database-import-worker",
                "image": "placeholder",
                "ports": [{"name": "metrics", "containerPort": 9090}],
                "env": [
                  {"name": "FUGUE_DATABASE_IMPORT_WORKER_DATABASE_URL", "valueFrom": {"secretKeyRef": {"name": "fugue-database-import-worker-database", "key": "database-url"}}},
                  {"name": "GOMEMLIMIT", "value": "640MiB"}
                ],
                "securityContext": {"allowPrivilegeEscalation": false, "readOnlyRootFilesystem": true, "capabilities": {"drop": ["ALL"]}},
                "volumeMounts": [{"name": "scratch", "mountPath": "/tmp"}],
                "resources": {"requests": {"cpu": "50m", "memory": "64Mi", "ephemeral-storage": "16Mi"}, "limits": {"cpu": "750m", "memory": "768Mi", "ephemeral-storage": "448Mi"}},
                "startupProbe": {"httpGet": {"path": "/healthz", "port": "metrics"}, "periodSeconds": 3, "failureThreshold": 14},
                "livenessProbe": {"httpGet": {"path": "/healthz", "port": "metrics"}, "timeoutSeconds": 3, "periodSeconds": 15},
                "readinessProbe": {"httpGet": {"path": "/readyz", "port": "metrics"}, "timeoutSeconds": 3, "periodSeconds": 5}
              }
            ]
          }
        }
      }
    }
  ]
}
