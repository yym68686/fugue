{
  "namespace": "fugue-system",
  "name": "fugue-storage-policy",
  "policy": {
    "version": 1,
    "compiler_input_chunks": true,
    "checkpoint_pages": true,
    "database_max_open": 24,
    "database_max_idle": 8,
    "database_idle_seconds": 60
  },
  "observationRetention": {
    "version": 1,
    "enabled": true,
    "interval_seconds": 30,
    "batch_rows": 500,
    "heartbeat_days": 7,
    "heartbeat_rows_per_chain": 10000,
    "probe_days": 7,
    "probe_rows_per_table": 1000000
  },
  "compilerInputCodec": {
    "version": 1,
    "enabled": true
  },
  "compilerInputSeparated": {
    "version": 1,
    "enabled": true
  },
  "compilerInputBlocks": {
    "version": 1,
    "minimum_bytes": 256,
    "boundary_bits": 4
  },
  "storageLifecycle": {
    "version": 1,
    "mode": "audit",
    "effective_from": "2026-11-16T00:00:00Z",
    "interval_seconds": 300,
    "source_page_rows": 64,
    "history_days": 7,
    "minimum_verified_versions": 3,
    "unused_upload_hours": 24,
    "unreferenced_upload_days": 30,
    "warning_free_percent": 20,
    "pressure_free_percent": 15,
    "critical_free_percent": 10
  },
  "artifactContentReferences": {
    "version": 1,
    "enabled": true
  }
}
