{
  "namespace": "fugue-system",
  "repository": "ghcr.io/yym68686/fugue-api",
  "catalog": {
    "protocol": "fugue.diagnostics/v1",
    "generation": 34,
    "runner_image": "$runner",
    "policy": {
      "namespaces": [
        "*"
      ],
      "profiles": [
        "host-read",
        "cluster-read",
        "process-profile",
        "kernel-profile"
      ],
      "service_account": "fugue-diagnostic-reader"
    },
    "probes": [
      {
        "id": "process-runqueue-latency",
        "description": "Bounded per-thread runnable wait from filtered scheduler events without changing schedstats",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process", "platform_component"],
        "max_duration_seconds": 60,
        "parameters": {},
        "config": {"collectors": [{"name": "node-resources", "kind": "node-snapshot", "interval_seconds": 10}, {"name": "runqueue", "kind": "process-runqueue-latency", "capture_seconds": 1, "interval_seconds": 120}]}
      },
      {
        "id": "process-page-faults",
        "description": "Bounded major-fault addresses attributed to stable process file mappings",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 60,
        "parameters": {
          "unit": {"default": "k3s.service", "max_length": 120, "pattern": "^[a-zA-Z0-9_@.:-]+\\.service$"},
          "since_seconds": {"default": "900", "max_length": 5, "pattern": "^[0-9]{1,5}$"},
          "match": {"max_length": 256, "pattern": "^[^\\r\\n]+$"}
        },
        "config": {"collectors": [
          {"name": "compaction-window", "kind": "host-loopback-metrics", "port": 2381, "interval_seconds": 15, "fields": ["etcd_server_slow_apply_total", "etcd_debugging_mvcc_index_compaction_pause_duration_milliseconds", "etcd_debugging_mvcc_db_compaction_pause_duration_milliseconds", "etcd_debugging_mvcc_db_compaction_total_duration_milliseconds", "etcd_debugging_mvcc_db_compaction_last", "etcd_debugging_mvcc_db_compaction_keys_total", "go_gc_duration_seconds", "process_cpu_seconds_total"]},
          {"name": "compaction-journal", "kind": "host-journal", "unit": "{{param.unit}}", "since_seconds": 900, "since_seconds_param": "{{param.since_seconds}}", "match_param": "{{param.match}}", "interval_seconds": 30, "match": ["finished scheduled compaction", "slow apply", "trace"]},
          {"name": "page-faults", "kind": "process-page-faults", "capture_seconds": 20, "interval_seconds": 120}
        ]}
      },
      {
        "id": "kubernetes-build-provenance",
        "description": "Selected embedded storage, API server and HTTP transport dependency versions from the running executable",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 30,
        "parameters": {},
        "config": {"collectors": [{"name": "build-provenance", "kind": "process-identity", "interval_seconds": 120, "go_modules": ["go.etcd.io/etcd/server/v3", "go.etcd.io/etcd/api/v3", "go.etcd.io/etcd/client/v3", "go.etcd.io/bbolt", "k8s.io/apiserver", "golang.org/x/net"]}]}
      },
      {
        "id": "storage-scan-cost",
        "description": "Correlated storage reads, Go heap/GC, process faults and node reclaim in one bounded window",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 360,
        "parameters": {},
        "config": {
          "collectors": [
            {"name": "node-resources", "kind": "node-snapshot", "interval_seconds": 10},
            {"name": "process-scheduling", "kind": "process-scheduling", "interval_seconds": 10},
            {"name": "storage-runtime", "kind": "host-loopback-metrics", "port": 2381, "interval_seconds": 15, "fields": ["etcd_disk_wal_fsync_duration_seconds", "etcd_disk_backend_commit_duration_seconds", "etcd_server_has_leader", "etcd_server_proposals_pending", "etcd_server_slow_apply_total", "etcd_server_slow_read_indexes_total", "etcd_server_read_indexes_failed_total", "etcd_mvcc_db_total_size_in_bytes", "etcd_mvcc_db_total_size_in_use_in_bytes", "process_cpu_seconds_total", "process_resident_memory_bytes", "go_gc_duration_seconds", "go_memstats_alloc_bytes", "go_memstats_alloc_bytes_total", "go_memstats_heap_inuse_bytes", "go_memstats_heap_alloc_bytes", "go_memstats_next_gc_bytes", "go_memstats_heap_sys_bytes", "go_memstats_mallocs_total", "go_memstats_frees_total"]}
          ]
        }
      },
      {
        "id": "kubernetes-storage-read-paths",
        "description": "Storage range reads, watch cache lifecycle and consistency checks",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": ["node", "platform_component"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [{
            "name": "storage-read-paths",
            "kind": "prometheus",
            "interval_seconds": 15,
            "service": {"namespace": "fugue-system", "name": "fugue-fugue-observability-prometheus", "port": "http"},
            "queries": {
              "families": "count by(__name__)({__name__=~\"apiserver_(storage_(consistency_checks_total|list_.*)|watch_cache_(initializations_total|consistent_read_total)|cache_list_.*)\"})",
              "consistency_checks": "sum by(group,resource,status)(apiserver_storage_consistency_checks_total)",
              "cache_initializations": "sum by(group,resource)(apiserver_watch_cache_initializations_total)",
              "consistent_cache_reads": "sum by(group,resource,success,fallback)(apiserver_watch_cache_consistent_read_total)",
              "storage_lists": "sum by(resource)(apiserver_storage_list_total)",
              "storage_fetched": "sum by(resource)(apiserver_storage_list_fetched_objects_total)",
              "cache_lists": "sum by(resource)(apiserver_cache_list_total)",
              "list_requests": "sum by(group,resource,code)(apiserver_request_total{verb=\"LIST\"})"
            },
            "required_queries": ["families", "list_requests", "consistency_checks", "cache_initializations", "storage_lists", "storage_fetched"]
          }, {
            "name": "recent-storage-read-window",
            "kind": "prometheus",
            "interval_seconds": 120,
            "service": {"namespace": "fugue-system", "name": "fugue-fugue-observability-prometheus", "port": "http"},
            "queries": {
              "consistency_checks": "apiserver_storage_consistency_checks_total{resource=~\"replicasets|endpoints|endpointslices|services|secrets\"}[1h]",
              "storage_fetched": "apiserver_storage_list_fetched_objects_total{resource=~\"replicasets|endpoints|endpointslices|services|secrets\"}[1h]",
              "cache_initializations": "apiserver_watch_cache_initializations_total{resource=~\"replicasets|endpoints|endpointslices|services|secrets\"}[1h]",
              "cache_fallback": "apiserver_watch_cache_consistent_read_total{resource=~\"replicasets|endpoints|endpointslices|services|secrets\",fallback=\"true\"}[1h]"
            },
            "required_queries": ["consistency_checks", "storage_fetched", "cache_initializations"]
          }]
        }
      },
      {
        "id": "kubernetes-object-changes",
        "description": "Short resource-version-bound watch of an exact object's status",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": ["platform_component"],
        "max_duration_seconds": 30,
        "parameters": {
          "resource": {"default": "clusters", "max_length": 80, "pattern": "^[a-z][a-z0-9.-]*$"},
          "group": {"default": "postgresql.cnpg.io", "max_length": 100, "pattern": "^[a-z][a-z0-9.-]*$"},
          "namespace": {"required": true, "max_length": 63, "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"required": true, "max_length": 253, "pattern": "^[a-z0-9][a-z0-9.-]*$"}
        },
        "config": {"collectors": [{"name": "object-changes", "kind": "kubernetes-object-changes", "group": "{{param.group}}", "resource": "{{param.resource}}", "namespace": "{{param.namespace}}", "object_name": "{{param.name}}", "fields": ["status"], "capture_seconds": 5, "interval_seconds": 120}]}
      },
      {
        "id": "kubernetes-audit-object-activity",
        "description": "Bounded object-level caller and write activity for an explicit Kubernetes resource",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 60,
        "parameters": {"resource": {"default": "clusters", "max_length": 80, "pattern": "^[a-z][a-z0-9.-]*$"}},
        "config": {"collectors": [{"name": "object-activity", "kind": "kubernetes-audit", "path": "/var/log/fugue/kubernetes/audit*.log", "policy_path": "/etc/rancher/k3s/audit-policy.yaml", "resource": "{{param.resource}}", "fields": ["object_name"], "since_seconds": 300, "interval_seconds": 120}]}
      },
      {
        "id": "host-storage-metrics",
        "description": "Bounded loopback storage metrics in the host network namespace",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {"collectors": [{"name": "storage-metrics", "kind": "host-loopback-metrics", "port": 2381, "interval_seconds": 15, "fields": ["etcd_disk_wal_fsync_duration_seconds", "etcd_disk_backend_commit_duration_seconds", "etcd_server_has_leader", "etcd_server_proposals_pending", "etcd_server_slow_apply_total", "etcd_server_slow_read_indexes_total", "etcd_server_read_indexes_failed_total", "etcd_mvcc_db_total_size_in_bytes", "etcd_mvcc_db_total_size_in_use_in_bytes", "process_cpu_seconds_total", "process_resident_memory_bytes", "go_gc_duration_seconds", "grpc_server_handled_total"]}]}
      },
      {
        "id": "process-cpu-frame-pointer",
        "description": "Bounded frame-pointer CPU capture with Go stack symbol resolution",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process", "platform_component"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {"collectors": [{"name": "cpu-profile", "kind": "process-cpu-profile", "capture_seconds": 20, "call_graph": "fp", "interval_seconds": 120}]}
      },
      {
        "id": "runtime-stage-cost",
        "description": "Fixed-cardinality operation counts and elapsed work from the runtime operations provider",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["platform_component"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {"collectors": [{"name": "stage-cost", "kind": "runtime-json", "path": "/v1/snapshots/operations", "interval_seconds": 30, "fields": ["schema", "started_at", "observed_at", "stages", "note"]}]}
      },
      {
        "id": "workload-log-window",
        "description": "Bounded recent workload logs from an exact admitted container",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": ["platform_component"],
        "max_duration_seconds": 30,
        "parameters": {"container": {"required": true, "max_length": 63, "pattern": "^[a-z0-9][a-z0-9-]*$"}, "since": {"max_length": 40, "pattern": "^[0-9T:.Z+-]+$"}},
        "config": {"collectors": [{"name": "workload-log", "kind": "kubernetes-logs", "namespace": "{{namespace}}", "object_name": "{{pod}}", "container": "{{param.container}}", "since_seconds": 900, "since_time": "{{param.since}}", "interval_seconds": 120}]}
      },
      {
        "id": "runtime-http-requests",
        "description": "Bounded Kubernetes client resource, cache, latency and response-size observations",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["platform_component"],
        "max_duration_seconds": 60,
        "parameters": {},
        "config": {"collectors": [{"name": "http-requests", "kind": "runtime-json", "path": "/v1/snapshots/http-client", "interval_seconds": 30, "fields": ["schema", "observed_at", "requests", "completed_total", "in_flight", "retained_limit", "overwritten", "note"]}]}
      },
      {
        "id": "runtime-source-progress",
        "description": "Read bounded runtime provider snapshots of source cursors, stages and collection budgets",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["platform_component"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [{"name": "source-progress", "kind": "runtime-json", "path": "/v1/snapshots/log-sources", "interval_seconds": 15, "fields": ["schema", "observed_at", "sources", "source_count", "truncated", "evicted_sources", "cycle", "queue_depth", "queued_bytes"]}]
        }
      },
      {
        "id": "perf-capture-comparison",
        "description": "Compare frozen PID and cgroup CPU capture with raw bounded perf summaries",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process", "platform_component"],
        "max_duration_seconds": 60,
        "parameters": {},
        "config": {
          "collectors": [{"name": "capture-comparison", "kind": "perf-capture-check", "interval_seconds": 120}]
        }
      },
      {
        "id": "kubernetes-audit-requests",
        "description": "Bounded audit request rates, callers, cache options and completed-request durations",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 30,
        "parameters": {},
        "config": {
          "collectors": [{"name": "audit-requests", "kind": "kubernetes-audit", "path": "/var/log/fugue/kubernetes/audit*.log", "policy_path": "/etc/rancher/k3s/audit-policy.yaml", "since_seconds": 300, "interval_seconds": 120}]
        }
      },
      {
        "id": "process-cpu-sampling",
        "description": "Bounded process CPU sample counts, cgroup pressure and symbol coverage",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process", "platform_component"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [{"name": "cpu-profile", "kind": "process-cpu-profile", "capture_seconds": 20, "interval_seconds": 120}]
        }
      },
      {
        "id": "host-service-journal",
        "description": "Read-only bounded host service logs with explicit coverage and timestamps",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 30,
        "parameters": {
          "unit": {"default": "k3s.service", "max_length": 120, "pattern": "^[a-zA-Z0-9_@.:-]+\\.service$"},
          "since_seconds": {"default": "900", "max_length": 5, "pattern": "^[0-9]{1,5}$"},
          "since": {"max_length": 40, "pattern": "^[0-9T:.Z+-]+$"},
          "until": {"max_length": 40, "pattern": "^[0-9T:.Z+-]+$"},
          "match": {"max_length": 256, "pattern": "^[^\r\n]+$"}
        },
        "config": {
          "collectors": [{"name": "service-log", "kind": "host-journal", "unit": "{{param.unit}}", "since_seconds": 900, "since_seconds_param": "{{param.since_seconds}}", "since_time": "{{param.since}}", "until_time": "{{param.until}}", "match_param": "{{param.match}}", "interval_seconds": 120, "match": ["took too long", "slow", "timeout", "deadline", "error", "warn", "trace"]}]
        }
      },
      {
        "id": "scheduler-pressure",
        "description": "Node CPU/IO pressure and process scheduling counters; no workload restart",
        "image": "$runner",
        "profile": "host-read",
        "target_types": [
          "node",
          "node_process",
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [
            {
              "name": "node-resources",
              "kind": "node-snapshot",
              "interval_seconds": 5
            },
            {
              "name": "process-scheduling",
              "kind": "process-scheduling",
              "interval_seconds": 5
            }
          ]
        }
      },
      {
        "id": "control-plane-latency",
        "description": "Correlated apiserver, etcd and node processing metrics",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "node",
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [
            {
              "name": "control-plane-requests",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "request_rate": "sum by (resource,verb,code) (rate(apiserver_request_total[5m]))",
                "request_p99": "histogram_quantile(0.99,sum by(le,resource,verb)(rate(apiserver_request_duration_seconds_bucket[5m])))",
                "inflight": "apiserver_current_inflight_requests",
                "queue_wait": "histogram_quantile(0.99,sum by(le)(rate(apiserver_flowcontrol_request_wait_duration_seconds_bucket[5m])))"
              }
            },
            {
              "name": "etcd-storage",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "wal_fsync_p99": "histogram_quantile(0.99,sum by(le)(rate(etcd_disk_wal_fsync_duration_seconds_bucket[5m])))",
                "commit_p99": "histogram_quantile(0.99,sum by(le)(rate(etcd_disk_backend_commit_duration_seconds_bucket[5m])))",
                "leader": "etcd_server_has_leader",
                "pending_proposals": "etcd_server_proposals_pending"
              },
              "required_queries": [
                "wal_fsync_p99",
                "commit_p99",
                "leader",
                "pending_proposals"
              ]
            },
            {
              "name": "node-workload",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "system_cpu": "rate(process_cpu_seconds_total{job=\"fugue-kubernetes-nodes\",node={{node}}}[3m])",
                "container_cpu": "topk(20,sum by(pod,container)(rate(container_cpu_usage_seconds_total{node={{node}},container!=\"\",container!=\"POD\"}[3m])))",
                "throttled_time": "sum by(pod,container)(rate(container_cpu_cfs_throttled_seconds_total{node={{node}},container!=\"\"}[3m]))"
              }
            },
            {
              "name": "available-control-metrics",
              "kind": "prometheus",
              "interval_seconds": 60,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "families": "count by(__name__,job)({__name__=~\"etcd_.+|cnpg_.+|workqueue_.+|controller_runtime_.+\"})",
                "targets": "up{job=~\".*kubernetes.*|.*cnpg.*\"}"
              },
              "required_queries": [
                "targets"
              ]
            }
          ]
        }
      },
      {
        "id": "kubernetes-reconcile",
        "description": "Read-only database controller logs and scheduling/storage object evidence",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {
          "namespace": {
            "default": "*",
            "description": "Namespace for database objects, or * for all visible namespaces",
            "max_length": 63,
            "pattern": "^(\\*|[a-z0-9][a-z0-9-]*[a-z0-9]|[a-z0-9])$"
          },
          "container": {
            "default": "manager",
            "max_length": 63,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "config": {
          "collectors": [
            {
              "name": "controller-log",
              "kind": "kubernetes-logs",
              "interval_seconds": 30,
              "namespace": "{{namespace}}",
              "object_name": "{{pod}}",
              "container": "{{param.container}}",
              "since_seconds": 180,
              "match": [
                "Selected PVC",
                "waiting for",
                "error",
                "Error",
                "already exists",
                "reconcile"
              ]
            },
            {
              "name": "database-clusters",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "clusters",
              "fields": [
                "spec.instances",
                "spec.plugins",
                "spec.affinity",
                "spec.storage",
                "spec.primaryUpdateStrategy",
                "status"
              ],
              "group": "postgresql.cnpg.io",
              "namespace": "{{param.namespace}}"
            },
            {
              "name": "database-pods",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "pods",
              "fields": [
                "spec.nodeName",
                "spec.affinity",
                "spec.nodeSelector",
                "spec.tolerations",
                "spec.volumes",
                "status"
              ],
              "namespace": "{{param.namespace}}",
              "selector": "cnpg.io/cluster"
            },
            {
              "name": "database-pvcs",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "persistentvolumeclaims",
              "fields": [
                "spec.volumeName",
                "spec.storageClassName",
                "spec.resources",
                "spec.accessModes",
                "status"
              ],
              "namespace": "{{param.namespace}}",
              "annotation_keys": [
                "cnpg.io/pvcStatus",
                "volume.kubernetes.io/selected-node",
                "pv.kubernetes.io/bind-completed",
                "fugue.pro/recovery-retained-cluster-uid",
                "fugue.pro/recovery-retained-reason"
              ]
            },
            {
              "name": "persistent-volumes",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "persistentvolumes",
              "fields": [
                "spec.nodeAffinity",
                "spec.claimRef",
                "spec.storageClassName",
                "spec.capacity",
                "spec.accessModes",
                "status"
              ]
            },
            {
              "name": "nodes",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "nodes",
              "fields": [
                "spec.taints",
                "status.conditions",
                "status.allocatable",
                "status.capacity"
              ]
            },
            {
              "name": "database-jobs",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "jobs",
              "group": "batch",
              "namespace": "{{param.namespace}}",
              "selector": "cnpg.io/cluster",
              "fields": [
                "status",
                "spec.suspend",
                "spec.backoffLimit"
              ]
            },
            {
              "name": "database-events",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "events",
              "namespace": "{{param.namespace}}",
              "fields": [
                "involvedObject",
                "reason",
                "message",
                "firstTimestamp",
                "lastTimestamp",
                "eventTime",
                "series",
                "count",
                "type",
                "reportingComponent"
              ]
            },
            {
              "name": "storage-classes",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "storageclasses",
              "group": "storage.k8s.io",
              "fields": [
                "provisioner",
                "volumeBindingMode",
                "allowedTopologies",
                "reclaimPolicy"
              ]
            },
            {
              "name": "managed-database-intent",
              "kind": "kubernetes-objects",
              "interval_seconds": 120,
              "resource": "managedapps",
              "group": "fugue.pro",
              "namespace": "{{param.namespace}}",
              "fields": [
                "spec.appID",
                "spec.name",
                "spec.appSpec.runtime_id",
                "spec.appSpec.postgres",
                "spec.backingServices",
                "spec.scheduling",
                "status"
              ],
              "version": "v1alpha1"
            },
            {
              "name": "database-service-selectors",
              "kind": "kubernetes-objects",
              "interval_seconds": 120,
              "resource": "services",
              "namespace": "{{param.namespace}}",
              "selector": "cnpg.io/cluster",
              "fields": [
                "spec.selector",
                "spec.clusterIP",
                "spec.ports"
              ]
            }
          ]
        }
      },
      {
        "id": "pipeline-backpressure",
        "description": "Queue, ingestion/export throughput, source coverage and recent pipeline warnings",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {
          "container": {
            "default": "telemetry-agent",
            "max_length": 63,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "config": {
          "collectors": [
            {
              "name": "pipeline-flow",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "queue": "{__name__=~\"fugue_telemetry_pipeline_queue_depth|fugue_telemetry_pipeline_queued_bytes\",job=\"fugue-telemetry-agent\"}",
                "events": "rate(fugue_telemetry_pipeline_events_total{job=\"fugue-telemetry-agent\"}[3m])",
                "source_lines": "rate(fugue_telemetry_pipeline_kubernetes_log_lines_total{job=\"fugue-telemetry-agent\"}[3m])",
                "coverage": "{__name__=~\"fugue_telemetry_pipeline_kubernetes_log_backlog_max_seconds|fugue_telemetry_pipeline_kubernetes_log_cycle_seconds|fugue_telemetry_pipeline_kubernetes_log_deferred_targets|fugue_telemetry_pipeline_kubernetes_log_cursor_gaps_total\",job=\"fugue-telemetry-agent\"}",
                "errors": "increase(fugue_telemetry_pipeline_errors_total{job=\"fugue-telemetry-agent\"}[3m])",
                "cpu": "sum(rate(container_cpu_usage_seconds_total{pod={{pod}},container!=\"\",container!=\"POD\"}[3m]))"
              },
              "required_queries": [
                "coverage",
                "queue",
                "events",
                "source_lines"
              ]
            },
            {
              "name": "pipeline-log",
              "kind": "kubernetes-logs",
              "interval_seconds": 30,
              "namespace": "{{namespace}}",
              "object_name": "{{pod}}",
              "container": "{{param.container}}",
              "since_seconds": 900,
              "match": [
                "warning",
                "error",
                "failed",
                "timeout",
                "deadline",
                "connection lost"
              ]
            },
            {
              "name": "recent-pipeline-window",
              "kind": "prometheus",
              "interval_seconds": 120,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "backlog": "fugue_telemetry_pipeline_kubernetes_log_backlog_max_seconds{job=\"fugue-telemetry-agent\"}[30m]",
                "deferred": "fugue_telemetry_pipeline_kubernetes_log_deferred_targets{job=\"fugue-telemetry-agent\"}[30m]",
                "queue": "fugue_telemetry_pipeline_queue_depth{job=\"fugue-telemetry-agent\"}[30m]",
                "lines": "fugue_telemetry_pipeline_kubernetes_log_lines_total{job=\"fugue-telemetry-agent\"}[30m]",
                "errors": "fugue_telemetry_pipeline_errors_total{job=\"fugue-telemetry-agent\"}[30m]"
              },
              "required_queries": [
                "backlog",
                "deferred",
                "queue",
                "lines",
                "errors"
              ]
            },
            {
              "name": "pipeline-effective-status",
              "kind": "service-json",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-telemetry-agent",
                "port": "http"
              },
              "path": "/readyz",
              "fields": [
                "status",
                "observability",
                "pipeline"
              ]
            }
          ]
        }
      },
      {
        "id": "cluster-target-inventory",
        "description": "Discover system workload runtime identities through bounded read-only observation",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "platform_component",
          "node"
        ],
        "max_duration_seconds": 60,
        "parameters": {
          "namespace": {
            "default": "fugue-system",
            "max_length": 63,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "config": {
          "collectors": [
            {
              "name": "workload-identities",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "pods",
              "namespace": "{{param.namespace}}",
              "fields": [
                "spec.nodeName",
                "status.phase",
                "status.conditions",
                "status.containerStatuses"
              ]
            }
          ]
        }
      },
      {
        "id": "process-runtime-identity",
        "description": "Inspect exact process executable and Go line-table layout without restarting the target",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": [
          "node_process",
          "platform_component"
        ],
        "max_duration_seconds": 30,
        "parameters": {},
        "config": {
          "collectors": [
            {
              "name": "executable-identity",
              "kind": "process-identity",
              "interval_seconds": 120
            }
          ]
        }
      }
    ]
  },
  "reader_rules": [
    {
      "apiGroups": [
        ""
      ],
      "resources": [
