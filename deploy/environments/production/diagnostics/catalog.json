{
  "namespace": "fugue-system",
  "repository": "ghcr.io/yym68686/fugue-api",
  "catalog": {
    "protocol": "fugue.diagnostics/v1",
    "generation": 13,
    "runner_image": "$runner",
    "policy": {
      "namespaces": [
        "*"
      ],
      "profiles": [
        "host-read",
        "cluster-read",
        "process-profile",
        "kernel-profile"
      ],
      "service_account": "fugue-diagnostic-reader"
    },
    "probes": [
      {
        "id": "runtime-source-progress",
        "description": "Read bounded runtime provider snapshots of source cursors, stages and collection budgets",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["platform_component"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [{"name": "source-progress", "kind": "runtime-json", "path": "/v1/snapshots/log-sources", "interval_seconds": 15, "fields": ["schema", "observed_at", "sources", "source_count", "truncated", "evicted_sources", "cycle", "queue_depth", "queued_bytes"]}]
        }
      },
      {
        "id": "perf-capture-comparison",
        "description": "Compare frozen PID and cgroup CPU capture with raw bounded perf summaries",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process", "platform_component"],
        "max_duration_seconds": 60,
        "parameters": {},
        "config": {
          "collectors": [{"name": "capture-comparison", "kind": "perf-capture-check", "interval_seconds": 120}]
        }
      },
      {
        "id": "kubernetes-audit-requests",
        "description": "Bounded audit request rates, callers, cache options and completed-request durations",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 30,
        "parameters": {},
        "config": {
          "collectors": [{"name": "audit-requests", "kind": "kubernetes-audit", "path": "/var/log/fugue/kubernetes/audit*.log", "policy_path": "/etc/rancher/k3s/audit-policy.yaml", "since_seconds": 300, "interval_seconds": 120}]
        }
      },
      {
        "id": "process-cpu-sampling",
        "description": "Bounded process CPU sample counts, cgroup pressure and symbol coverage",
        "image": "$runner",
        "profile": "kernel-profile",
        "target_types": ["node_process", "platform_component"],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [{"name": "cpu-profile", "kind": "process-cpu-profile", "capture_seconds": 20, "interval_seconds": 120}]
        }
      },
      {
        "id": "host-service-journal",
        "description": "Read-only bounded host service logs with explicit coverage and timestamps",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": ["node_process"],
        "max_duration_seconds": 30,
        "parameters": {
          "unit": {"default": "k3s.service", "max_length": 120, "pattern": "^[a-zA-Z0-9_@.:-]+\\.service$"}
        },
        "config": {
          "collectors": [{"name": "service-log", "kind": "host-journal", "unit": "{{param.unit}}", "since_seconds": 900, "interval_seconds": 120, "match": ["took too long", "slow", "timeout", "deadline", "error", "warn", "trace"]}]
        }
      },
      {
        "id": "scheduler-pressure",
        "description": "Node CPU/IO pressure and process scheduling counters; no workload restart",
        "image": "$runner",
        "profile": "host-read",
        "target_types": [
          "node",
          "node_process",
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [
            {
              "name": "node-resources",
              "kind": "node-snapshot",
              "interval_seconds": 5
            },
            {
              "name": "process-scheduling",
              "kind": "process-scheduling",
              "interval_seconds": 5
            }
          ]
        }
      },
      {
        "id": "control-plane-latency",
        "description": "Correlated apiserver, etcd and node processing metrics",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "node",
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {},
        "config": {
          "collectors": [
            {
              "name": "control-plane-requests",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "request_rate": "sum by (resource,verb,code) (rate(apiserver_request_total[5m]))",
                "request_p99": "histogram_quantile(0.99,sum by(le,resource,verb)(rate(apiserver_request_duration_seconds_bucket[5m])))",
                "inflight": "apiserver_current_inflight_requests",
                "queue_wait": "histogram_quantile(0.99,sum by(le)(rate(apiserver_flowcontrol_request_wait_duration_seconds_bucket[5m])))"
              }
            },
            {
              "name": "etcd-storage",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "wal_fsync_p99": "histogram_quantile(0.99,sum by(le)(rate(etcd_disk_wal_fsync_duration_seconds_bucket[5m])))",
                "commit_p99": "histogram_quantile(0.99,sum by(le)(rate(etcd_disk_backend_commit_duration_seconds_bucket[5m])))",
                "leader": "etcd_server_has_leader",
                "pending_proposals": "etcd_server_proposals_pending"
              },
              "required_queries": [
                "wal_fsync_p99",
                "commit_p99",
                "leader",
                "pending_proposals"
              ]
            },
            {
              "name": "node-workload",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "system_cpu": "rate(process_cpu_seconds_total{job=\"fugue-kubernetes-nodes\",node={{node}}}[3m])",
                "container_cpu": "topk(20,sum by(pod,container)(rate(container_cpu_usage_seconds_total{node={{node}},container!=\"\",container!=\"POD\"}[3m])))",
                "throttled_time": "sum by(pod,container)(rate(container_cpu_cfs_throttled_seconds_total{node={{node}},container!=\"\"}[3m]))"
              }
            },
            {
              "name": "available-control-metrics",
              "kind": "prometheus",
              "interval_seconds": 60,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "families": "count by(__name__,job)({__name__=~\"etcd_.+|cnpg_.+|workqueue_.+|controller_runtime_.+\"})",
                "targets": "up{job=~\".*kubernetes.*|.*cnpg.*\"}"
              },
              "required_queries": [
                "targets"
              ]
            }
          ]
        }
      },
      {
        "id": "kubernetes-reconcile",
        "description": "Read-only database controller logs and scheduling/storage object evidence",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {
          "namespace": {
            "default": "*",
            "description": "Namespace for database objects, or * for all visible namespaces",
            "max_length": 63,
            "pattern": "^(\\*|[a-z0-9][a-z0-9-]*[a-z0-9]|[a-z0-9])$"
          },
          "container": {
            "default": "manager",
            "max_length": 63,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "config": {
          "collectors": [
            {
              "name": "controller-log",
              "kind": "kubernetes-logs",
              "interval_seconds": 30,
              "namespace": "{{namespace}}",
              "object_name": "{{pod}}",
              "container": "{{param.container}}",
              "since_seconds": 180,
              "match": [
                "Selected PVC",
                "waiting for",
                "error",
                "Error",
                "already exists",
                "reconcile"
              ]
            },
            {
              "name": "database-clusters",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "clusters",
              "fields": [
                "spec.instances",
                "spec.affinity",
                "spec.storage",
                "spec.primaryUpdateStrategy",
                "status"
              ],
              "group": "postgresql.cnpg.io",
              "namespace": "{{param.namespace}}"
            },
            {
              "name": "database-pods",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "pods",
              "fields": [
                "spec.nodeName",
                "spec.affinity",
                "spec.nodeSelector",
                "spec.tolerations",
                "spec.volumes",
                "status"
              ],
              "namespace": "{{param.namespace}}",
              "selector": "cnpg.io/cluster"
            },
            {
              "name": "database-pvcs",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "persistentvolumeclaims",
              "fields": [
                "spec.volumeName",
                "spec.storageClassName",
                "spec.resources",
                "spec.accessModes",
                "status"
              ],
              "namespace": "{{param.namespace}}",
              "annotation_keys": [
                "cnpg.io/pvcStatus",
                "volume.kubernetes.io/selected-node",
                "pv.kubernetes.io/bind-completed",
                "fugue.pro/recovery-retained-cluster-uid",
                "fugue.pro/recovery-retained-reason"
              ]
            },
            {
              "name": "persistent-volumes",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "persistentvolumes",
              "fields": [
                "spec.nodeAffinity",
                "spec.claimRef",
                "spec.storageClassName",
                "spec.capacity",
                "spec.accessModes",
                "status"
              ]
            },
            {
              "name": "nodes",
              "kind": "kubernetes-objects",
              "interval_seconds": 30,
              "resource": "nodes",
              "fields": [
                "spec.taints",
                "status.conditions",
                "status.allocatable",
                "status.capacity"
              ]
            },
            {
              "name": "database-jobs",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "jobs",
              "group": "batch",
              "namespace": "{{param.namespace}}",
              "selector": "cnpg.io/cluster",
              "fields": [
                "status",
                "spec.suspend",
                "spec.backoffLimit"
              ]
            },
            {
              "name": "database-events",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "events",
              "namespace": "{{param.namespace}}",
              "fields": [
                "involvedObject",
                "reason",
                "message",
                "firstTimestamp",
                "lastTimestamp",
                "eventTime",
                "series",
                "count",
                "type",
                "reportingComponent"
              ]
            },
            {
              "name": "storage-classes",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "storageclasses",
              "group": "storage.k8s.io",
              "fields": [
                "provisioner",
                "volumeBindingMode",
                "allowedTopologies",
                "reclaimPolicy"
              ]
            },
            {
              "name": "managed-database-intent",
              "kind": "kubernetes-objects",
              "interval_seconds": 120,
              "resource": "managedapps",
              "group": "fugue.pro",
              "namespace": "{{param.namespace}}",
              "fields": [
                "spec.appID",
                "spec.name",
                "spec.appSpec.runtime_id",
                "spec.appSpec.postgres",
                "spec.backingServices",
                "spec.scheduling",
                "status"
              ],
              "version": "v1alpha1"
            },
            {
              "name": "database-service-selectors",
              "kind": "kubernetes-objects",
              "interval_seconds": 120,
              "resource": "services",
              "namespace": "{{param.namespace}}",
              "selector": "cnpg.io/cluster",
              "fields": [
                "spec.selector",
                "spec.clusterIP",
                "spec.ports"
              ]
            }
          ]
        }
      },
      {
        "id": "pipeline-backpressure",
        "description": "Queue, ingestion/export throughput, source coverage and recent pipeline warnings",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "platform_component"
        ],
        "max_duration_seconds": 120,
        "parameters": {
          "container": {
            "default": "telemetry-agent",
            "max_length": 63,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "config": {
          "collectors": [
            {
              "name": "pipeline-flow",
              "kind": "prometheus",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "queue": "{__name__=~\"fugue_telemetry_pipeline_queue_depth|fugue_telemetry_pipeline_queued_bytes\",job=\"fugue-telemetry-agent\"}",
                "events": "rate(fugue_telemetry_pipeline_events_total{job=\"fugue-telemetry-agent\"}[3m])",
                "source_lines": "rate(fugue_telemetry_pipeline_kubernetes_log_lines_total{job=\"fugue-telemetry-agent\"}[3m])",
                "coverage": "{__name__=~\"fugue_telemetry_pipeline_kubernetes_log_backlog_max_seconds|fugue_telemetry_pipeline_kubernetes_log_cycle_seconds|fugue_telemetry_pipeline_kubernetes_log_deferred_targets|fugue_telemetry_pipeline_kubernetes_log_cursor_gaps_total\",job=\"fugue-telemetry-agent\"}",
                "errors": "increase(fugue_telemetry_pipeline_errors_total{job=\"fugue-telemetry-agent\"}[3m])",
                "cpu": "sum(rate(container_cpu_usage_seconds_total{pod={{pod}},container!=\"\",container!=\"POD\"}[3m]))"
              },
              "required_queries": [
                "coverage",
                "queue",
                "events",
                "source_lines"
              ]
            },
            {
              "name": "pipeline-log",
              "kind": "kubernetes-logs",
              "interval_seconds": 30,
              "namespace": "{{namespace}}",
              "object_name": "{{pod}}",
              "container": "{{param.container}}",
              "since_seconds": 900,
              "match": [
                "warning",
                "error",
                "failed",
                "timeout",
                "deadline",
                "connection lost"
              ]
            },
            {
              "name": "recent-pipeline-window",
              "kind": "prometheus",
              "interval_seconds": 120,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-observability-prometheus",
                "port": "http"
              },
              "queries": {
                "backlog": "fugue_telemetry_pipeline_kubernetes_log_backlog_max_seconds{job=\"fugue-telemetry-agent\"}[30m]",
                "deferred": "fugue_telemetry_pipeline_kubernetes_log_deferred_targets{job=\"fugue-telemetry-agent\"}[30m]",
                "queue": "fugue_telemetry_pipeline_queue_depth{job=\"fugue-telemetry-agent\"}[30m]",
                "lines": "fugue_telemetry_pipeline_kubernetes_log_lines_total{job=\"fugue-telemetry-agent\"}[30m]",
                "errors": "fugue_telemetry_pipeline_errors_total{job=\"fugue-telemetry-agent\"}[30m]"
              },
              "required_queries": [
                "backlog",
                "deferred",
                "queue",
                "lines",
                "errors"
              ]
            },
            {
              "name": "pipeline-effective-status",
              "kind": "service-json",
              "interval_seconds": 15,
              "service": {
                "namespace": "fugue-system",
                "name": "fugue-fugue-telemetry-agent",
                "port": "http"
              },
              "path": "/readyz",
              "fields": [
                "status",
                "observability",
                "pipeline"
              ]
            }
          ]
        }
      },
      {
        "id": "cluster-target-inventory",
        "description": "Discover system workload runtime identities through bounded read-only observation",
        "image": "$runner",
        "profile": "cluster-read",
        "target_types": [
          "platform_component",
          "node"
        ],
        "max_duration_seconds": 60,
        "parameters": {
          "namespace": {
            "default": "fugue-system",
            "max_length": 63,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "config": {
          "collectors": [
            {
              "name": "workload-identities",
              "kind": "kubernetes-objects",
              "interval_seconds": 60,
              "resource": "pods",
              "namespace": "{{param.namespace}}",
              "fields": [
                "spec.nodeName",
                "status.phase",
                "status.conditions",
                "status.containerStatuses"
              ]
            }
          ]
        }
      },
      {
        "id": "process-runtime-identity",
        "description": "Inspect exact process executable and Go line-table layout without restarting the target",
        "image": "$runner",
        "profile": "process-profile",
        "target_types": [
          "node_process",
          "platform_component"
        ],
        "max_duration_seconds": 30,
        "parameters": {},
        "config": {
          "collectors": [
            {
              "name": "executable-identity",
              "kind": "process-identity",
              "interval_seconds": 120
            }
          ]
        }
      }
    ]
  },
  "reader_rules": [
    {
      "apiGroups": [
        ""
      ],
      "resources": [
        "nodes",
        "pods",
        "pods/log",
        "services",
        "events",
        "persistentvolumeclaims",
        "persistentvolumes"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "apps"
      ],
      "resources": [
        "deployments",
        "statefulsets",
        "replicasets"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "postgresql.cnpg.io"
      ],
      "resources": [
        "clusters"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "storage.k8s.io"
      ],
      "resources": [
        "storageclasses",
        "volumeattachments",
        "csinodes",
        "csidrivers",
        "csistoragecapacities"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "batch"
      ],
      "resources": [
        "jobs"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "fugue.pro"
      ],
      "resources": [
        "managedapps"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    }
  ],
  "api_service_account": "fugue-fugue-control-plane-sa"
}
